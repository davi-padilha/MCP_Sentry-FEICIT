[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "mcp-sentry-gateway"
version = "0.2.0"
description = "Deterministic local integrity core for the MCP Sentry MVP"
requires-python = ">=3.11"
dependencies = ["mcp==1.29.0"]

[project.scripts]
mcp-sentry = "mcp_sentry_gateway.cli:main"
mcp-sentry-gateway = "mcp_sentry_gateway.gateway:main"
mcp-sentry-verificar-demo = "mcp_sentry_gateway.verificacao_da_demonstracao:main"
