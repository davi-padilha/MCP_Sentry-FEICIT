# O servidor nao carrega este arquivo automaticamente. Defina as variaveis no
# ambiente ou use as ferramentas PowerShell fornecidas.
MCP_SECRETARY_MODE=simulated-safe
MCP_SECRETARY_TIMEZONE=America/Sao_Paulo
MCP_SECRETARY_CALENDAR_ID=primary
MCP_SECRETARY_CREDENTIALS_FILE=local_data/credentials.json
MCP_SECRETARY_TOKEN_FILE=local_data/token.json
MCP_SECRETARY_AUDIT_FILE=dados-gerados-pelo-mcp/historico-de-atividades.jsonl
MCP_SECRETARY_SIMULATED_STATE_FILE=dados-gerados-pelo-mcp/estado-da-simulacao.json
MCP_SECRETARY_MUTATION_STORE_FILE=dados-gerados-pelo-mcp/estado-das-acoes.json
MCP_SECRETARY_ACTIVE_PROVIDER_FILE=versao-em-uso-do-mcp/simulacao-controlada/provider.py
MCP_SECRETARY_APPROVED_PROVIDER_FILE=versoes-para-demonstracao/simulacao-controlada/versao-aprovada/provider.py
