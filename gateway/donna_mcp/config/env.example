# O servidor nao carrega este arquivo automaticamente. Defina as variaveis no
# ambiente ou use os scripts PowerShell fornecidos.
MCP_SECRETARY_MODE=simulated-safe
MCP_SECRETARY_TIMEZONE=America/Sao_Paulo
MCP_SECRETARY_CALENDAR_ID=primary
MCP_SECRETARY_CREDENTIALS_FILE=local_data/credentials.json
MCP_SECRETARY_TOKEN_FILE=local_data/token.json
MCP_SECRETARY_AUDIT_FILE=runtime/audit.jsonl
MCP_SECRETARY_SIMULATED_STATE_FILE=runtime/simulated_state.json
MCP_SECRETARY_MUTATION_STORE_FILE=runtime/mutations.json
MCP_SECRETARY_ACTIVE_PROVIDER_FILE=runtime/active_version/provider.py
MCP_SECRETARY_APPROVED_PROVIDER_FILE=examples/demo_versions/approved/provider.py
