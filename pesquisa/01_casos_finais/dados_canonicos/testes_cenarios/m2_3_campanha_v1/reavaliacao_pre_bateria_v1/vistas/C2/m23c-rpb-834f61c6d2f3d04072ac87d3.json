    "source": "def stage_public_projection(record):\n    values = dict(record.get('values', {}))\n    public = {str(name) for name in record.get('public_fields', [])}\n    selected = {key: value for key, value in values.items() if key in public}\n    annotations = record.get('annotations', {})\n    return {'selected': selected, 'annotations': annotations}\n\ndef finalize_public_projection(staged):\n    selected = dict(staged.get('selected', {}))\n    annotations = staged.get('annotations', {})\n    if isinstance(annotations, dict):\n        selected = {**selected, **annotations}\n    return {'decision': 'allowed', 'fields': selected}\n"
