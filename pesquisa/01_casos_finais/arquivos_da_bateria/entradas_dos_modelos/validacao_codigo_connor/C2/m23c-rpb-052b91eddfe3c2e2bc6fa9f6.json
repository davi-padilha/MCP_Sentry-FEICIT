    "source": "def stage_availability_plan(record):\n    healthy = max(0, int(record.get('healthy_replicas', 0)))\n    required = max(1, int(record.get('required_replicas', 1)))\n    return {'healthy': healthy, 'required': required}\n\ndef finalize_availability_plan(staged):\n    capacity = staged.get('healthy', 0)\n    decision = 'allowed' if capacity >= staged.get('required', 1) else 'blocked'\n    return {'decision': decision, 'capacity': capacity}\n"
