{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "intent": {
      "additionalProperties": false,
      "properties": {
        "attempt": {"maximum": 3, "minimum": 1, "type": "integer"},
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "case_id": {"minLength": 1, "type": "string"},
        "condition": {"enum": ["C1", "C2", "D"]},
        "intent_id": {"minLength": 1, "type": "string"},
        "pair_id": {"minLength": 1, "type": "string"},
        "position_id": {"enum": ["remote-gpt-5-6-luna-high-openai", "remote-gpt-5-6-sol-medium-openai", "remote-claude-opus-5-medium-anthropic"]},
        "recorded_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "type": "string"},
        "repetition": {"enum": ["R1", "R2", "R3"]},
        "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reserved_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "unit_id": {"minLength": 1, "type": "string"}
      },
      "required": ["intent_id", "unit_id", "pair_id", "position_id", "case_id", "condition", "repetition", "attempt", "request_sha256", "reserved_usd", "recorded_at", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    },
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "accepted_by_contract": {"type": "object"},
        "accounted_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "attempt": {"maximum": 3, "minimum": 1, "type": "integer"},
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "classification": {"enum": ["valid_semantic_response", "terminal_structural_or_semantic_failure", "retryable_transport_failure", "terminal_transport_failure", "aborted_cost_violation"]},
        "completed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "type": "string"},
        "cost_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": ["string", "null"]},
        "effective_provider": {"type": ["string", "null"]},
        "effective_revision": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "intent_id": {"minLength": 1, "type": "string"},
        "latency_ms": {"minimum": 0, "type": "integer"},
        "observed_or_echoed": {"type": "object"},
        "raw_response": {"type": ["string", "null"]},
        "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "requested_parameters": {"type": "object"},
        "reserved_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "semantic_action": {"enum": ["bloquear", "permitir", "inconclusiva", null]},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "started_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "type": "string"},
        "transport_kind": {"enum": ["response", "http", "connection", "timeout", "connection_interrupted"]},
        "unit_id": {"minLength": 1, "type": "string"}
      },
      "required": ["intent_id", "unit_id", "attempt", "request_sha256", "classification", "transport_kind", "http_status", "started_at", "completed_at", "latency_ms", "reserved_usd", "cost_usd", "accounted_usd", "semantic_action", "effective_provider", "effective_revision", "requested_parameters", "accepted_by_contract", "observed_or_echoed", "raw_response", "error", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    },
    "checkpoint": {
      "additionalProperties": false,
      "properties": {
        "attempt": {"maximum": 3, "minimum": 1, "type": "integer"},
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "semantic_action": {"enum": ["bloquear", "permitir", "inconclusiva", null]},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "state": {"enum": ["OK", "FAIL"]},
        "unit_id": {"minLength": 1, "type": "string"}
      },
      "required": ["unit_id", "attempt", "request_sha256", "state", "semantic_action", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "case_id": {"minLength": 1, "type": "string"},
        "condition": {"enum": ["C1", "C2", "D"]},
        "pair_id": {"minLength": 1, "type": "string"},
        "position_id": {"enum": ["remote-gpt-5-6-luna-high-openai", "remote-gpt-5-6-sol-medium-openai", "remote-claude-opus-5-medium-anthropic"]},
        "r1_action": {"enum": ["bloquear", "permitir", "inconclusiva", null]},
        "r2_action": {"enum": ["bloquear", "permitir", "inconclusiva", null]},
        "r3_action": {"enum": ["bloquear", "permitir", "inconclusiva", null]},
        "r3_diagnostic": {"type": "boolean"},
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["pair_id", "position_id", "case_id", "condition", "r1_action", "r2_action", "r3_action", "r3_diagnostic", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    },
    "closure": {
      "additionalProperties": false,
      "properties": {
        "analysis_authorized": {"const": false},
        "attempts": {"minimum": 0, "type": "integer"},
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "cost_accounted_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "cost_observed_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "error": {"type": ["string", "null"]},
        "primary_units_terminal": {"maximum": 900, "minimum": 0, "type": "integer"},
        "r3_units_terminal": {"maximum": 450, "minimum": 0, "type": "integer"},
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "session": {"minimum": 1, "type": "integer"},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "status": {"enum": ["COMPLETE_PENDING_INDEPENDENT_REVIEW", "ABORTED"]}
      },
      "required": ["status", "session", "primary_units_terminal", "r3_units_terminal", "attempts", "cost_observed_usd", "cost_accounted_usd", "analysis_authorized", "error", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    },
    "execution_manifest": {
      "additionalProperties": false,
      "properties": {
        "authorization_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "cost_accounted_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "cost_observed_usd": {"pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "type": "string"},
        "counts": {
          "additionalProperties": false,
          "properties": {
            "attempts": {"minimum": 900, "type": "integer"},
            "pairs": {"const": 450},
            "primary_units": {"const": 900},
            "r3_units": {"maximum": 450, "minimum": 0, "type": "integer"}
          },
          "required": ["pairs", "primary_units", "r3_units", "attempts"],
          "type": "object"
        },
        "files": {
          "additionalProperties": false,
          "properties": {
            "checkpoints.jsonl": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "fechamento.jsonl": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "intencoes.jsonl": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "resultados.jsonl": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "tentativas.jsonl": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
          },
          "required": ["intencoes.jsonl", "tentativas.jsonl", "checkpoints.jsonl", "resultados.jsonl", "fechamento.jsonl"],
          "type": "object"
        },
        "run_id": {"pattern": "^m2_3_extension_campaign_[A-Za-z0-9_-]{1,64}$", "type": "string"},
        "schema_version": {"const": "m2_3_extension_execution_manifest_v1"},
        "snapshot_id": {"const": "m2_3_extensao_multimodelo_v1_ready"},
        "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["schema_version", "files", "counts", "cost_observed_usd", "cost_accounted_usd", "run_id", "authorization_sha256", "snapshot_id", "snapshot_sha256"],
      "type": "object"
    }
  },
  "schema_version": "m2_3_extension_campaign_record_schemas_v1"
}
