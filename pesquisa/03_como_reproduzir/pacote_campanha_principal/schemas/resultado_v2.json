{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "type": "string"
    },
    "condition": {
      "enum": [
        "C1",
        "C2",
        "D"
      ],
      "type": "string"
    },
    "no_majority_no_replacement": {
      "const": true
    },
    "pair_id": {
      "minLength": 1,
      "type": "string"
    },
    "position_id": {
      "minLength": 1,
      "type": "string"
    },
    "r1_action": {
      "enum": [
        "bloquear",
        "permitir",
        "inconclusiva",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "r2_action": {
      "enum": [
        "bloquear",
        "permitir",
        "inconclusiva",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "r3_action": {
      "enum": [
        "bloquear",
        "permitir",
        "inconclusiva",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "r3_diagnostic": {
      "type": "boolean"
    }
  },
  "required": [
    "pair_id",
    "position_id",
    "case_id",
    "condition",
    "r1_action",
    "r2_action",
    "r3_action",
    "r3_diagnostic",
    "no_majority_no_replacement"
  ],
  "type": "object"
}
