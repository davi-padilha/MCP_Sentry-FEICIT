{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "lane": {
      "enum": [
        "local_pc_a",
        "cloud_pc_b"
      ],
      "type": "string"
    },
    "persisted_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "state": {
      "enum": [
        "valid_semantic_response",
        "terminal_structural_or_semantic_failure",
        "terminal_transport_failure",
        "synthetic_completed"
      ],
      "type": "string"
    },
    "unit_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "attempt_id",
    "lane",
    "state",
    "persisted_at"
  ],
  "type": "object"
}
