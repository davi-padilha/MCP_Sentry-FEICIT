{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "catalog_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "completed_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "effective_cost_usd": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "endpoint_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallback_used": {
      "type": "boolean"
    },
    "generation_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "http_status": {
      "maximum": 599,
      "minimum": 100,
      "type": [
        "integer",
        "null"
      ]
    },
    "input_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "latency_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "const": "preflight_real"
    },
    "output_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "python_runtime": {
      "additionalProperties": false,
      "properties": {
        "executable_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "executable_sha256"
      ],
      "type": "object"
    },
    "reasoning_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "started_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "step_ordinal": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "OK",
        "BLOCKED"
      ],
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "run_id",
    "step_ordinal",
    "machine",
    "lane",
    "position_id",
    "authorization_sha256",
    "python_runtime",
    "mode",
    "started_at",
    "completed_at",
    "requested_model",
    "requested_provider",
    "requested_endpoint",
    "effective_identity",
    "endpoint_revision",
    "endpoint_variant",
    "request_payload_without_headers",
    "catalog_evidence",
    "generation_evidence",
    "route_evidence",
    "routing_policy",
    "request_sha256",
    "parameter_observations",
    "price",
    "http_status",
    "response_id",
    "input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "latency_ms",
    "effective_cost_usd",
    "error",
    "reserved_cost_usd",
    "budget_accounted_usd",
    "cumulative_preflight_cost_usd",
    "fixture_response",
    "fixture_schema_valid",
    "fallback_used",
    "verdict",
    "stop_code"
  ],
  "type": "object"
}
