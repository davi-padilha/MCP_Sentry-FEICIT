{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "type": "string"
    },
    "campaign_authorized": {
      "const": false
    },
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "const": "APPROVE_POST_PREFLIGHT_PRESERVATION"
    },
    "independent_review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "model_execution_authorized": {
      "const": false
    },
    "recorded": {
      "const": true
    },
    "schema_version": {
      "const": "m2_3_post_preflight_human_approval_v1"
    },
    "sidecar_authorized": {
      "const": false
    },
    "unit_id": {
      "const": "POST-PREFLIGHT-PROMOTE-01"
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "recorded",
    "decision",
    "candidate_manifest_sha256",
    "independent_review_sha256",
    "approved_by",
    "approved_at",
    "campaign_authorized",
    "sidecar_authorized",
    "model_execution_authorized"
  ],
  "type": "object"
}
