{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {"type": "string"},
    "approved_by": {"minLength": 1, "type": "string"},
    "approved_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "authorization_statement": {"const": "Autorizo a campanha real M2.3 em bloco único, sequencial, nas duas lanes lógicas, com teto externo de US$ 25."},
    "execution_authorized": {"const": true},
    "execution_capability": {"const": "real_transport"},
    "external_budget_cap_usd": {"const": 25},
    "lanes": {"const": ["local_pc_a", "cloud_pc_b"]},
    "machine_execution_mode": {"const": "single_pc_sequential_lanes"},
    "official_campaign_authorized": {"const": true},
    "preflight_execution_authorized": {"const": false},
    "recorded": {"const": true},
    "run_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"},
    "schema_version": {"const": "m2_3_campaign_authorization_v2"},
    "scope": {"const": "campaign_real"},
    "snapshot_id": {"const": "m2_3_campaign_g1_v2_ready"},
    "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "validation_only": {"const": false}
  },
  "required": ["schema_version", "recorded", "scope", "run_id", "approved_at", "approved_by", "approved_commit", "snapshot_id", "snapshot_sha256", "lanes", "machine_execution_mode", "external_budget_cap_usd", "validation_only", "execution_capability", "execution_authorized", "preflight_execution_authorized", "official_campaign_authorized", "authorization_statement"],
  "type": "object"
}
