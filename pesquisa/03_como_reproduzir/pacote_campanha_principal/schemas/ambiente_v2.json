{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        },
        "cpu": {
          "minLength": 1,
          "type": "string"
        },
        "gpu": {
          "minLength": 1,
          "type": "string"
        },
        "identity_source": {
          "const": "ollama_api_tags_and_runtime_pre_call"
        },
        "lane": {
          "const": "local_pc_a"
        },
        "machine": {
          "minLength": 1,
          "type": "string"
        },
        "observed_environment_identity": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "local_digest": {
              "minLength": 1,
              "type": "string"
            },
            "model_revision": {
              "minLength": 1,
              "type": "string"
            },
            "ollama_version": {
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "type": "string"
            },
            "provider_endpoint_revision": {
              "minLength": 1,
              "type": "string"
            },
            "template_revision": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model_revision",
            "provider_endpoint_revision",
            "local_digest",
            "ollama_version",
            "template_revision"
          ],
          "type": "object"
        },
        "os": {
          "minLength": 1,
          "type": "string"
        },
        "position_id": {
          "minLength": 1,
          "type": "string"
        },
        "ram": {
          "minLength": 1,
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "position_id",
        "machine",
        "os",
        "cpu",
        "gpu",
        "ram",
        "runtime",
        "timezone",
        "captured_at",
        "lane",
        "identity_source",
        "observed_environment_identity"
      ],
      "type": "object"
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        },
        "cpu": {
          "minLength": 1,
          "type": "string"
        },
        "effective_identity_status": {
          "enum": [
            "pending_preflight",
            "captured_pre_call"
          ],
          "type": "string"
        },
        "gpu": {
          "minLength": 1,
          "type": "string"
        },
        "lane": {
          "const": "cloud_pc_b"
        },
        "machine": {
          "minLength": 1,
          "type": "string"
        },
        "os": {
          "minLength": 1,
          "type": "string"
        },
        "position_id": {
          "minLength": 1,
          "type": "string"
        },
        "ram": {
          "minLength": 1,
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "position_id",
        "machine",
        "os",
        "cpu",
        "gpu",
        "ram",
        "runtime",
        "timezone",
        "captured_at",
        "lane",
        "effective_identity_status"
      ],
      "type": "object"
    }
  ]
}
