{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "campaign_authorized": {
      "const": false
    },
    "inference_completed": {
      "const": false
    },
    "intent_kind": {
      "const": "pre_call_fail_closed"
    },
    "intent_recorded_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "lane": {
      "enum": [
        "local_pc_a",
        "cloud_pc_b"
      ],
      "type": "string"
    },
    "machine": {
      "enum": [
        "PC-A",
        "PC-B"
      ],
      "type": "string"
    },
    "position_id": {
      "minLength": 1,
      "type": "string"
    },
    "python_runtime": {
      "additionalProperties": false,
      "properties": {
        "executable_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "executable_sha256"
      ],
      "type": "object"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reserved_cost_usd": {
      "maximum": 5,
      "minimum": 0,
      "type": "number"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "m2_3_preflight_call_intent_v1"
    },
    "step_ordinal": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "intent_kind",
    "run_id",
    "authorization_sha256",
    "python_runtime",
    "step_ordinal",
    "machine",
    "lane",
    "position_id",
    "request_sha256",
    "reserved_cost_usd",
    "intent_recorded_at",
    "inference_completed",
    "campaign_authorized"
  ],
  "type": "object"
}
