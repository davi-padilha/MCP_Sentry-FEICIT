{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_parameters": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "const": "synthetic_not_observed"
        }
      ]
    },
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "attempt_number": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "budget_accounted_usd": {
      "minimum": 0,
      "type": "number"
    },
    "case_id": {
      "minLength": 1,
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "condition": {
      "enum": [
        "C1",
        "C2",
        "D"
      ],
      "type": "string"
    },
    "cost_usd": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "effective_endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_local_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_ollama_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_template_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_code": {
      "enum": [
        "identity_effective_failure",
        "structural_or_semantic_failure",
        "transport_failure",
        "response_refusal",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "input_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "lane": {
      "enum": [
        "local_pc_a",
        "cloud_pc_b"
      ],
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "machine": {
      "enum": [
        "PC-A",
        "PC-B"
      ],
      "type": "string"
    },
    "next_attempt_not_before": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        }
      ]
    },
    "output_tokens": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "pair_id": {
      "minLength": 1,
      "type": "string"
    },
    "position_id": {
      "minLength": 1,
      "type": "string"
    },
    "raw_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_classification": {
      "enum": [
        "valid_semantic_response",
        "terminal_structural_or_semantic_failure",
        "terminal_transport_failure",
        "retryable_transport_failure",
        "valid_semantic_synthetic",
        "invalid_json_synthetic",
        "refusal_synthetic",
        "terminal_transport_failure_synthetic",
        "retryable_transport_failure_synthetic"
      ],
      "type": "string"
    },
    "repetition": {
      "enum": [
        "R1",
        "R2",
        "R3"
      ],
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "requested_endpoint": {
      "minLength": 1,
      "type": "string"
    },
    "requested_gateway": {
      "enum": [
        "ollama_chat",
        "openrouter_chat_completions",
        "openrouter_responses",
        "synthetic_no_gateway"
      ],
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "type": "string"
    },
    "requested_parameters": {
      "type": "object"
    },
    "requested_provider": {
      "minLength": 1,
      "type": "string"
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_delay_seconds": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "run_kind": {
      "enum": [
        "campaign_real",
        "ensaio_estrutural_falso_nao_experimental"
      ],
      "type": "string"
    },
    "semantic_action": {
      "enum": [
        "bloquear",
        "permitir",
        "inconclusiva",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$",
      "type": "string"
    },
    "unit_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "unit_id",
    "pair_id",
    "run_kind",
    "lane",
    "machine",
    "snapshot_id",
    "snapshot_sha256",
    "case_id",
    "condition",
    "position_id",
    "repetition",
    "requested_gateway",
    "requested_model",
    "requested_provider",
    "requested_endpoint",
    "started_at",
    "completed_at",
    "record_classification",
    "request_sha256",
    "attempt_number",
    "requested_parameters",
    "accepted_parameters",
    "effective_provider",
    "effective_endpoint",
    "effective_revision",
    "effective_local_digest",
    "effective_ollama_version",
    "effective_template_revision",
    "response_id",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "latency_ms",
    "budget_accounted_usd",
    "raw_response",
    "error",
    "failure_code",
    "semantic_action",
    "retry_delay_seconds",
    "next_attempt_not_before"
  ],
  "type": "object"
}
